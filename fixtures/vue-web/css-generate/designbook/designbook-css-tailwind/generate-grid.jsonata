/** @config
 {
   "input": "../design-system/design-tokens.yml",
   "output": "../../css/tokens/grid.src.css"
 }
 */
(
  $entries := $each($$.component.grid.gap, function($v, $k) {
    $substring($k, 0, 1) != "$" ? "  --grid-" & $k & ": " & $replace($v."$value", /\{primitive\.spacing\.(\w+)\}/, "var(--spacing-$1)") & ";"
  });
  "@theme static {\n" & $join($entries, "\n") & "\n}\n"
)
