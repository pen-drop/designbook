{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch(*)",
      "WebSearch",
      "mcp__claude-in-chrome__*",
      "mcp__stitch__*",
      "Skill(update-config)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "prefersReducedMotion": true,
  "enabledPlugins": {
    "designbook@designbook": false,
    "designbook-drupal@designbook": false,
    "designbook-css-tailwind@designbook": false,
    "designbook-stitch@designbook": false,
    "designbook-gaia@designbook": false
  }
}
